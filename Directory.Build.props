<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <!-- The single source of the Jourfold version. Packages, installers and the About window read it from here,
         and the release workflow only accepts the tag v$(Version). Print it with: python eng/version.py -->
    <Version>0.7.0</Version>
    <!-- TravelRepo package version used when ../travelrepo is not checked out beside this repository. -->
    <TravelRepoVersion>0.6.0</TravelRepoVersion>
    <Authors>Jourfold contributors</Authors>
    <!-- Public source repository, shown in the About window. -->
    <RepositoryUrl>https://github.com/travelrepo-org/jourfold</RepositoryUrl>
    <!-- Product website, shown in the About window and the Windows installer. eng/version.py prints it with the website option. -->
    <WebsiteUrl>https://jourfold.dev</WebsiteUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
    <AssemblyMetadata Include="WebsiteUrl" Value="$(WebsiteUrl)" />
    <!-- Public client ID of the GitHub App that sign-in uses. Official releases get it from the release workflow; other
         builds leave it out and ask for one, or pass their own with -p:JourfoldGitHubClientId=... -->
    <AssemblyMetadata Include="GitHubClientId" Value="$(JourfoldGitHubClientId)" Condition="'$(JourfoldGitHubClientId)' != ''" />
  </ItemGroup>
</Project>
