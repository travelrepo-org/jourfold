<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Shown by the system while the app starts: the mark on the app background, light or deep navy. -->
  <style name="Theme.Jourfold.Starting" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/app_background</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    <item name="postSplashScreenTheme">@style/Theme.Jourfold</item>
  </style>
  <style name="Theme.Jourfold" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowBackground">@color/app_background</item>
  </style>
</resources>
