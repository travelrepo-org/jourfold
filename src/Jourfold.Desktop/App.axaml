<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Jourfold.Desktop.App" RequestedThemeVariant="Default" Name="Jourfold">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Jourfold.UI/Theme/Tokens.axaml"/>
        <ResourceInclude Source="avares://Jourfold.UI/Theme/Icons.axaml"/>
        <ResourceInclude Source="avares://Jourfold.UI/Theme/Brand.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <StyleInclude Source="avares://Jourfold.UI/Theme/Fluent.axaml"/>
    <StyleInclude Source="avares://Jourfold.Desktop/Theme/Controls.axaml"/>
  </Application.Styles>
</Application>
