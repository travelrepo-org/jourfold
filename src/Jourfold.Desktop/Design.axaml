<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Jourfold.Desktop">
 <Styles.Resources>
  <ResourceDictionary><local:TooltipTextConverter x:Key="TooltipText"/><ResourceDictionary.ThemeDictionaries>
   <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="Surface">#F7FAFB</SolidColorBrush><SolidColorBrush x:Key="Panel">#FFFFFF</SolidColorBrush><SolidColorBrush x:Key="Ink">#13344C</SolidColorBrush><SolidColorBrush x:Key="Line">#D9E5E9</SolidColorBrush><SolidColorBrush x:Key="Accent">#087F8C</SolidColorBrush></ResourceDictionary>
   <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="Surface">#0D2133</SolidColorBrush><SolidColorBrush x:Key="Panel">#142D42</SolidColorBrush><SolidColorBrush x:Key="Ink">#EDF7FA</SolidColorBrush><SolidColorBrush x:Key="Line">#35546A</SolidColorBrush><SolidColorBrush x:Key="Accent">#55CFBC</SolidColorBrush></ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries></ResourceDictionary>
 </Styles.Resources>
 <Style Selector="Window"><Setter Property="FontFamily" Value="avares://Jourfold.Desktop/Assets/Fonts#Plus Jakarta Sans"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
 <Style Selector="Button"><Setter Property="ToolTip.Tip" Value="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource TooltipText}}"/><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style Selector="Button:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="BorderThickness" Value="2"/></Style>
 <Style Selector="Button.primary"><Setter Property="Background" Value="#087F8C"/><Setter Property="Foreground" Value="White"/></Style>
 <Style Selector="TextBox"><Setter Property="CornerRadius" Value="5"/></Style>
 <Style Selector="Border.panel"><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/></Style>
 <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="23"/><Setter Property="FontWeight" Value="Bold"/></Style>
 <Style Selector="TextBlock.meta"><Setter Property="Opacity" Value="0.7"/><Setter Property="FontSize" Value="11"/></Style>
 <Style Selector="Window.compact Button"><Setter Property="Padding" Value="8,4"/></Style>
 <Style Selector="ListBox"><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderThickness" Value="0"/></Style>
 <Style Selector="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,2"/></Style>
 <Style Selector="Button.navigation"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,2"/></Style>
 <Style Selector="Button.navigation.selected"><Setter Property="Background" Value="#D7EEF0"/><Setter Property="Foreground" Value="#12394D"/></Style>
 <Style Selector="TextBox"><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/></Style>
 <Style Selector="ComboBox"><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/></Style>
</Styles>
