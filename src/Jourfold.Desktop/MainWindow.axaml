<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Jourfold.Desktop.MainWindow"
        Title="Jourfold" Width="1440" Height="900" MinWidth="960" MinHeight="620" Icon="/Assets/Branding/icon-256.png" WindowStartupLocation="CenterScreen">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+K" Command="{Binding SearchCommand}"/>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}"/>
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding QuickAddCommand}"/>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding CreateVersionCommand}"/>
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding SettingsCommand}"/>
    <KeyBinding Gesture="F5" Command="{Binding SyncCommand}"/>
  </Window.KeyBindings>
  <Panel>
    <LayoutTransformControl x:Name="RootLayout">
      <Grid x:Name="WorkspaceLayout" RowDefinitions="Auto,*">
        <Border x:Name="TitleBar" IsVisible="False" Height="34" Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <Image Source="{StaticResource Brand.Mark}" Width="16" Height="16"/>
            <TextBlock x:Name="TitleText" Text="Jourfold" FontSize="12" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Panel Grid.Row="1">
          <ContentControl x:Name="LibraryHost"/>
          <Grid x:Name="TripShell" ColumnDefinitions="Auto,*,Auto" IsVisible="False">
            <Border x:Name="Sidebar" Width="236" Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"/>
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*">
              <Border x:Name="Header" Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"/>
              <Border x:Name="Banner" Grid.Row="1"/>
              <Border x:Name="ToolbarHost" Grid.Row="2"/>
              <Grid Grid.Row="3" ColumnDefinitions="Auto,*">
                <Border x:Name="InboxHost"/>
                <ContentControl x:Name="MainContent" Grid.Column="1"/>
              </Grid>
            </Grid>
            <Border x:Name="InspectorHost" Grid.Column="2" Width="384" Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0"/>
          </Grid>
        </Panel>
      </Grid>
    </LayoutTransformControl>
    <Grid x:Name="DialogLayer"/>
    <StackPanel x:Name="ToastLayer" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24" Spacing="8"/>
  </Panel>
</Window>
