      <SolidColorBrush x:Key="Brand.Mint">#45C4AF</SolidColorBrush>
      <SolidColorBrush x:Key="Danger">#F2877C</SolidColorBrush>
      <SolidColorBrush x:Key="Danger.Soft">#3A1C23</SolidColorBrush>
      <SolidColorBrush x:Key="Warning">#F5D08A</SolidColorBrush>
      <SolidColorBrush x:Key="Warning.Soft">#352B15</SolidColorBrush>
      <SolidColorBrush x:Key="Warning.Line">#7A6020</SolidColorBrush>
      <SolidColorBrush x:Key="Success">#76D7A4</SolidColorBrush>
      <SolidColorBrush x:Key="Success.Soft">#11342A</SolidColorBrush>
      <SolidColorBrush x:Key="Info">#86B9F2</SolidColorBrush>
      <SolidColorBrush x:Key="Info.Soft">#142C47</SolidColorBrush>
      <SolidColorBrush x:Key="Overlay">#B3040C16</SolidColorBrush>
      <SolidColorBrush x:Key="NowLine">#FF7A7A</SolidColorBrush>
      <SolidColorBrush x:Key="Map.Land">#10263B</SolidColorBrush>
      <SolidColorBrush x:Key="Map.Grid">#1A3550</SolidColorBrush>
      <Color x:Key="Shadow.Color">#40000000</Color>

      <SolidColorBrush x:Key="Kind.Activity.Bg">#123A3D</SolidColorBrush><SolidColorBrush x:Key="Kind.Activity.Fg">#9BE7DA</SolidColorBrush><SolidColorBrush x:Key="Kind.Activity.Bar">#3EC6B0</SolidColorBrush>
