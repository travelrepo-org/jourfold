      <SolidColorBrush x:Key="Bg.Grid">#0C1E31</SolidColorBrush>
      <SolidColorBrush x:Key="Line">#1F3A55</SolidColorBrush>
      <SolidColorBrush x:Key="Line.Soft">#172E46</SolidColorBrush>
      <SolidColorBrush x:Key="Line.Strong">#2D4C6A</SolidColorBrush>
      <SolidColorBrush x:Key="Text">#E7F0F5</SolidColorBrush>
      <SolidColorBrush x:Key="Text.Muted">#A8BACA</SolidColorBrush>
      <SolidColorBrush x:Key="Text.Subtle">#7D93A7</SolidColorBrush>
      <SolidColorBrush x:Key="Text.OnAccent">#04211E</SolidColorBrush>
      <SolidColorBrush x:Key="Accent">#3EC6B0</SolidColorBrush>
      <SolidColorBrush x:Key="Accent.Hover">#58D1BD</SolidColorBrush>
