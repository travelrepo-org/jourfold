<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Jourfold.Mobile.MobileApp" RequestedThemeVariant="Default" Name="Jourfold">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Jourfold.UI/Theme/Tokens.axaml"/>
        <ResourceInclude Source="avares://Jourfold.UI/Theme/Icons.axaml"/>
        <ResourceInclude Source="avares://Jourfold.UI/Theme/Brand.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- Text sizes at the standard setting; TextScale sets them for the device's text size. -->
      <x:Double x:Key="ControlContentThemeFontSize">15</x:Double>
      <x:Double x:Key="Size.Body">15</x:Double>
      <x:Double x:Key="Size.H1">24</x:Double>
      <x:Double x:Key="Size.H2">20</x:Double>
      <x:Double x:Key="Size.H3">17</x:Double>
      <x:Double x:Key="Size.Title">16</x:Double>
      <x:Double x:Key="Size.Caption">13</x:Double>
      <x:Double x:Key="Size.Small">12</x:Double>
      <x:Double x:Key="Size.Time">14</x:Double>
      <x:Double x:Key="Size.Chip">14</x:Double>
      <x:Double x:Key="Size.Tab">12</x:Double>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <StyleInclude Source="avares://Jourfold.UI/Theme/Fluent.axaml"/>
    <StyleInclude Source="avares://Jourfold.Mobile/Theme/MobileControls.axaml"/>
  </Application.Styles>
</Application>
