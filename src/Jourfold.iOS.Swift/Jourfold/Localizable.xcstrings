          "stringUnit": {
            "state": "translated",
            "value": "In der Leiste"
          }
        }
      }
    },
    "In the trip's currency. ≈ is estimated with exchange rates, because no charged amount was entered.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Währung der Reise. ≈ ist mit Wechselkursen geschätzt, weil kein abgebuchter Betrag eingetragen ist."
