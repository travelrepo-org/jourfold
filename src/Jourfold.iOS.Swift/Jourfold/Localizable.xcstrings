    "%@: converted with the exchange rates on this phone and rounded to whole units.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: umgerechnet mit den Wechselkursen auf diesem Telefon und auf ganze Einheiten gerundet."
          }
        }
      }
    },
    "%@: the payments of %@ are more than the price of %@, for example with fees; the price is removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Die Zahlungen von %@ sind mehr als der Preis von %@, etwa durch Gebühren; der Preis wird entfernt."
          }
        }
      }
    },
    "%@: the price of %@ becomes a payment still to pay.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Der Preis von %@ wird eine noch offene Zahlung."
          }
        }
      }
    },
    "%@: the price of %@ stays, because its payments are in another currency. Look at it in the booking.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Der Preis von %@ bleibt, weil die Zahlungen in einer anderen Währung sind. Sehen Sie ihn sich in der Buchung an."
