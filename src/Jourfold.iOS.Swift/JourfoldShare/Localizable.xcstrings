            "value": "Buchungen"
          }
        }
      }
    },
    "Jourfold adds it the next time you open the app. Nothing leaves this phone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jourfold fügt es beim nächsten Öffnen der App hinzu. Nichts verlässt dieses Telefon."
          }
        }
      }
    },
