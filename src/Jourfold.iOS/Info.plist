<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key>
  <string>Jourfold</string>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>de</string>
  </array>
  <key>LSRequiresIPhoneOS</key>
  <true/>
  <key>UIDeviceFamily</key>
  <array>
    <integer>1</integer>
    <integer>2</integer>
  </array>
  <key>UIRequiredDeviceCapabilities</key>
  <array>
    <string>arm64</string>
  </array>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <!-- Avalonia draws into a window scene; one window is enough. -->
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <false/>
  </dict>
  <key>UILaunchStoryboardName</key>
  <string>LaunchScreen</string>
  <key>XSAppIconAssets</key>
  <string>Assets.xcassets/AppIcon.appiconset</string>
  <!-- The texts iOS shows when it asks for a permission; German ones are in Resources/de.lproj/InfoPlist.strings. -->
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>Jourfold uses your location only when you tap “Where I am” or “My location”. It is not kept or sent anywhere.</string>
  <key>NSCalendarsFullAccessUsageDescription</key>
  <string>Jourfold shows each trip as a calendar of its own and keeps it up to date with the plan.</string>
  <key>NSCalendarsUsageDescription</key>
  <string>Jourfold shows each trip as a calendar of its own and keeps it up to date with the plan.</string>
  <key>NSCameraUsageDescription</key>
  <string>Take a photo of a receipt for the trip.</string>
  <!-- Notices are worked out again in the background when iOS allows it (IosNotices). -->
  <key>UIBackgroundModes</key>
  <array>
    <string>fetch</string>
  </array>
  <key>BGTaskSchedulerPermittedIdentifiers</key>
  <array>
    <string>dev.jourfold.app.notices</string>
  </array>
  <!-- Tickets, PDFs, e-mails and pictures can be opened in Jourfold from other apps and the share sheet. iOS hands over a
       copy, so the original stays where it is. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Travel documents</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.adobe.pdf</string>
        <string>com.apple.pkpass</string>
        <string>com.apple.mail.email</string>
        <string>public.image</string>
        <string>public.plain-text</string>
      </array>
    </dict>
  </array>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <false/>
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
</dict>
</plist>
