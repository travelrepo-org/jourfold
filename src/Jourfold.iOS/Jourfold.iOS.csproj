<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <!-- An Apple ID without the developer program can only sign an ID of its own; pass one with
         -p:ApplicationId=dev.jourfold.app.yourname (docs/mobile.md). -->
    <ApplicationId>dev.jourfold.app</ApplicationId>
    <ApplicationTitle>Jourfold</ApplicationTitle>
    <!-- The same build number as on Android (0.8.0 becomes 800000, plus the build), so a newer build always counts
         as an update. -->
    <IosBuildNumber Condition="'$(IosBuildNumber)' == ''">0</IosBuildNumber>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <VersionMajor>$([System.Version]::Parse('$(Version)').Major)</VersionMajor>
    <VersionMinor>$([System.Version]::Parse('$(Version)').Minor)</VersionMinor>
    <VersionPatch>$([System.Version]::Parse('$(Version)').Build)</VersionPatch>
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Multiply($([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($(VersionMajor), 10000)), $([MSBuild]::Multiply($(VersionMinor), 100)))), $(VersionPatch))), 1000)), $(IosBuildNumber)))</ApplicationVersion>
    <!-- RuntimeIdentifiers only for restoring both (-p:RestoreAllRids=true): during a build the iOS SDK takes any
         simulator in that list as a simulator build, also with -r ios-arm64, and links the simulator's libraries. -->
    <RuntimeIdentifiers Condition="'$(RestoreAllRids)' == 'true'">ios-arm64;iossimulator-arm64</RuntimeIdentifiers>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- LibGit2Sharp hands libgit2 delegates (the HTTP transport, progress, sign-in) that ahead-of-time code alone
         cannot call back into on a device. The interpreter makes those callbacks work; everything else stays compiled
         ahead of time (-all). -->
    <UseInterpreter>true</UseInterpreter>
    <MtouchInterpreter>-all</MtouchInterpreter>
    <!-- Mono's own code generator: with LLVM the ahead-of-time step for the generic instances (aot-instances.dll) ran
         for over half an hour without finishing. -->
    <MtouchUseLlvm>false</MtouchUseLlvm>
    <!-- libgit2 for iOS is built by eng/build-libgit2-ios.sh in the TravelRepo repository. -->
    <Libgit2Ios>$(MSBuildThisFileDirectory)../../artifacts/libgit2-ios</Libgit2Ios>
  </PropertyGroup>
  <PropertyGroup>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>
  <!-- With entitlements the build looks for a signing identity; the simulator needs none and signs ad hoc. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('iossimulator-'))">
    <CodesignKey>-</CodesignKey>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Jourfold.Mobile/Jourfold.Mobile.csproj"/>
    <ProjectReference Include="../../../travelrepo/src/TravelRepo.Git.LibGit2/TravelRepo.Git.LibGit2.csproj" Condition="Exists('../../../travelrepo/src/TravelRepo.Git.LibGit2/TravelRepo.Git.LibGit2.csproj')"/>
    <PackageReference Include="TravelRepo.Git.LibGit2" Version="$(TravelRepoVersion)" Condition="!Exists('../../../travelrepo/src/TravelRepo.Git.LibGit2/TravelRepo.Git.LibGit2.csproj')"/>
    <PackageReference Include="Avalonia.iOS" Version="12.1.4"/>
    <!-- The package ships libgit2 for desktops only; the app brings its own as a framework. -->
    <PackageReference Include="LibGit2Sharp.NativeBinaries" Version="2.0.324" ExcludeAssets="native;build;buildTransitive"/>
    <NativeReference Include="$(Libgit2Ios)/git2.xcframework" Kind="Framework" Condition="Exists('$(Libgit2Ios)/git2.xcframework')"/>
  </ItemGroup>
  <ItemGroup><Using Include="Jourfold.UI"/></ItemGroup>
</Project>
